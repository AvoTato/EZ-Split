{
  "name": "ez-split-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "MODEL": "claude-haiku-5-5",
    "ALLOWED_ORIGINS": "http://localhost:8081,http://localhost:19006"
  },
  "ratelimits": [
    {
      // AI calls, device registration and the public "I've paid" button.
      "name": "RATE_LIMITER",
      "namespace_id": "48213",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // Backups and shared-bill traffic from the app, and viewing the bill page.
      "name": "DATA_LIMITER",
      "namespace_id": "48214",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  // Create with `npx wrangler d1 create ez-split`, then paste the id it prints here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ez-split",
      "database_id": "80788e74-1a5f-4ab0-82c5-e163810ea287",
      "migrations_dir": "migrations"
    }
  ]
}
